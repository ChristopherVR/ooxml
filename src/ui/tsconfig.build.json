{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"emitDeclarationOnly": true,
		"types": [],
		"paths": {
			"ooxml-ui/pptx/dom": ["./.types-pptx/pptx/dom/index.d.ts"],
			"ooxml-core/*": ["../core/dist/*/index.d.ts"]
		}
	},
	"exclude": [
		"src/manifest.ts",
		"src/**/*.test.ts",
		"src/**/__fixtures__/**",
		"dist",
		"node_modules",
		"src/pptx"
	],
	"files": ["src/raw.d.ts"]
}
