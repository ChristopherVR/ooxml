{
	"name": "ooxml-ui",
	"version": "1.37.0",
	"description": "Shared, format-neutral web components and styles for the Office viewers (Word, PowerPoint, Excel)",
	"keywords": [
		"custom-elements",
		"docx",
		"office",
		"pptx",
		"ribbon",
		"web-components"
	],
	"homepage": "https://github.com/ChristopherVR/ooxml/tree/main/src/ui#readme",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "src/ui"
	},
	"files": [
		"dist",
		"custom-elements.json",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"./dist/pptx/index.mjs",
		"./dist/pptx/index.cjs"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme.d.ts",
			"import": "./dist/theme.js",
			"default": "./dist/theme.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"import": "./dist/icons.js",
			"default": "./dist/icons.js"
		},
		"./chart-format-locales": {
			"types": "./dist/chart/format-pane-locales/index.d.ts",
			"import": "./dist/chart-format-locales.js",
			"default": "./dist/chart-format-locales.js"
		},
		"./controls": {
			"types": "./dist/controls.d.ts",
			"import": "./dist/controls.js",
			"default": "./dist/controls.js"
		},
		"./presence": {
			"types": "./dist/presence.d.ts",
			"import": "./dist/presence.js",
			"default": "./dist/presence.js"
		},
		"./smartart": {
			"types": "./dist/smartart.d.ts",
			"import": "./dist/smartart.js",
			"default": "./dist/smartart.js"
		},
		"./teams": {
			"types": "./dist/teams/index.d.ts",
			"import": "./dist/teams.js",
			"default": "./dist/teams.js"
		},
		"./bindings": {
			"types": "./dist/bindings/index.d.ts",
			"import": "./dist/bindings.js",
			"default": "./dist/bindings.js"
		},
		"./bindings/react": {
			"types": "./dist/bindings/react.d.ts",
			"import": "./dist/bindings/react.js",
			"default": "./dist/bindings/react.js"
		},
		"./bindings/vue": {
			"types": "./dist/bindings/vue.d.ts",
			"import": "./dist/bindings/vue.js",
			"default": "./dist/bindings/vue.js"
		},
		"./bindings/solid": {
			"types": "./dist/bindings/solid.d.ts",
			"import": "./dist/bindings/solid.js",
			"default": "./dist/bindings/solid.js"
		},
		"./suite": {
			"types": "./dist/suite/index.d.ts",
			"import": "./dist/suite.js",
			"default": "./dist/suite.js"
		},
		"./docx": {
			"types": "./dist/docx/index.d.ts",
			"import": "./dist/docx.js",
			"default": "./dist/docx.js"
		},
		"./visio": {
			"types": "./dist/visio/index.d.ts",
			"import": "./dist/visio.js",
			"default": "./dist/visio.js"
		},
		"./xlsx": {
			"types": "./dist/xlsx/index.d.ts",
			"import": "./dist/xlsx.js",
			"default": "./dist/xlsx.js"
		},
		"./package.json": "./package.json",
		"./custom-elements.json": "./custom-elements.json",
		"./pptx": {
			"types": "./dist/pptx/index.d.ts",
			"import": "./dist/pptx/index.mjs",
			"require": "./dist/pptx/index.cjs"
		},
		"./pptx/theme": {
			"types": "./dist/pptx/theme/index.d.ts",
			"import": "./dist/pptx/theme/index.mjs",
			"require": "./dist/pptx/theme/index.cjs"
		},
		"./pptx/loader": {
			"types": "./dist/pptx/loader/index.d.ts",
			"import": "./dist/pptx/loader/index.mjs",
			"require": "./dist/pptx/loader/index.cjs"
		},
		"./pptx/i18n": {
			"types": "./dist/pptx/i18n/index.d.ts",
			"import": "./dist/pptx/i18n/index.mjs",
			"require": "./dist/pptx/i18n/index.cjs"
		},
		"./pptx/ai": {
			"types": "./dist/pptx/ai/index.d.ts",
			"import": "./dist/pptx/ai/index.mjs",
			"require": "./dist/pptx/ai/index.cjs"
		},
		"./pptx/*": {
			"types": "./dist/pptx/*.d.ts",
			"import": "./dist/pptx/*.mjs",
			"require": "./dist/pptx/*.cjs"
		},
		"./pptx/dom": {
			"types": "./dist/pptx/dom/index.d.ts",
			"import": "./dist/pptx/dom/index.mjs",
			"require": "./dist/pptx/dom/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepack": "node scripts/ensure-built.mjs",
		"typecheck": "tsc -p tsconfig.pptx.json --outDir .types-pptx && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.pptx.json --noEmit",
		"test": "vitest run",
		"test:package": "node scripts/package-smoke.mjs",
		"gen:manifest": "node scripts/gen-manifest.mjs",
		"test:pptx": "vitest run --project 'pptx*'"
	},
	"dependencies": {
		"dompurify": "^3.4.17",
		"emf-converter": "4.23.1",
		"lit": "^3.3.3",
		"ooxml-core": "*",
		"opentype.js": "^2.0.0",
		"prosemirror-collab": "^1.3.1",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.4",
		"prosemirror-view": "^1.42.7",
		"yjs": "^13.6.33",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "^3.0.77",
		"@types/jsdom": "^30.0.0",
		"@types/opentype.js": "^1.3.10",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"ai": "^7.0.150",
		"fake-indexeddb": "^6.2.6",
		"happy-dom": "^21.0.4",
		"jsdom": "^30.1.3",
		"jszip": "^3.10.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"solid-js": "^1.9.17",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"vue": "^3.5.44"
	},
	"peerDependencies": {
		"ai": ">=6.0.0 <8",
		"react": ">=18",
		"solid-js": "^1.9.0",
		"three": "^0.186.1",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		},
		"ai": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"customElements": "custom-elements.json"
}
