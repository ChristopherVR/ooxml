{
	// The pptx area predates this repository's strict flags and is compiled with them relaxed.
	// Tighten gradually; new code elsewhere stays strict (see AGENTS.md).
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Core's own editor modules must resolve the model before dist exists.
		"paths": {
			"#embedded-workbook-chart": ["./xlsx/ui/dialogs/embedded-chart-entry.ts"],
			"#xpath-runtime": ["./xml/xpath-runtime.ts"],
			"#inkml-runtime": ["./drawingml/inkml/runtime.ts"],
			"ooxml-core/pptx": ["./pptx/index.ts"]
		},
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": false,
		"forceConsistentCasingInFileNames": true,
		"declarationMap": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noEmit": true
	},
	"include": [
		"pptx/**/*.ts",
		"pptx/**/*.tsx",
		"test-support/security-corpus/cases/pptx-collaboration.ts"
	],
	"exclude": [
		"**/dist/**",
		"**/node_modules/**",
		"pptx/**/*.test.ts",
		"pptx/**/*.test.tsx",
		"pptx/__tests__/fixtures/e2e/**"
	]
}
