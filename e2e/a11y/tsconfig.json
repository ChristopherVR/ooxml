{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", "test-results", "playwright-report"]
}
