{
	"name": "@christophervr/ooxml-opc",
	"version": "0.1.0",
	"description": "OPC packaging for OOXML: relationships, content types, part paths and zip-level helpers",
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.json",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@christophervr/ooxml-xml": "file:../xml",
		"jszip": "^3.10.2"
	}
}
