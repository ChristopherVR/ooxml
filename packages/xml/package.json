			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.json",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12"
	}
}
