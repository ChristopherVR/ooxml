{
	"name": "@christophervr/ooxml-xml",
	"version": "0.1.0",
	"description": "The shared OOXML XML model: strict DOM parsing and serialization, namespaces and namespace-aware helpers",
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
