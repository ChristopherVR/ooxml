{
	"name": "ooxml-core",
	"version": "0.13.0",
	"description": "Shared OOXML logic for the Word, PowerPoint and Excel viewers: everything except the UI",
	"keywords": [
		"charts",
		"docx",
		"drawingml",
		"office",
		"ooxml",
		"opc",
		"pptx",
		"presentationml",
		"smartart",
		"spreadsheetml",
		"wordprocessingml",
		"xls",
		"xlsx"
	],
	"homepage": "https://github.com/ChristopherVR/ooxml#readme",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git"
	},
	"bin": {
		"pptx": "./dist/pptx/cli/index.mjs"
	},
	"workspaces": [
		"packages/*"
	],
	"files": [
		"dist",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-LICENSES",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./units": {
			"types": "./dist/units/index.d.ts",
			"import": "./dist/units/index.mjs",
			"require": "./dist/units/index.cjs"
		},
		"./color": {
			"types": "./dist/color/index.d.ts",
			"import": "./dist/color/index.mjs",
			"require": "./dist/color/index.cjs"
		},
		"./geometry": {
			"types": "./dist/geometry/index.d.ts",
			"import": "./dist/geometry/index.mjs",
			"require": "./dist/geometry/index.cjs"
		},
		"./chart": {
			"types": "./dist/chart/index.d.ts",
			"import": "./dist/chart/index.mjs",
			"require": "./dist/chart/index.cjs"
		},
		"./text": {
			"types": "./dist/text/index.d.ts",
			"import": "./dist/text/index.mjs",
			"require": "./dist/text/index.cjs"
		},
		"./diagram": {
			"types": "./dist/diagram/index.d.ts",
			"import": "./dist/diagram/index.mjs",
			"require": "./dist/diagram/index.cjs"
		},
		"./digest": {
			"types": "./dist/digest/index.d.ts",
			"import": "./dist/digest/index.mjs",
			"require": "./dist/digest/index.cjs"
		},
		"./crypto": {
			"types": "./dist/crypto/index.d.ts",
			"import": "./dist/crypto/index.mjs",
			"require": "./dist/crypto/index.cjs"
		},
		"./xml": {
			"types": "./dist/xml/index.d.ts",
			"import": "./dist/xml/index.mjs",
			"require": "./dist/xml/index.cjs"
		},
		"./opc": {
			"types": "./dist/opc/index.d.ts",
			"import": "./dist/opc/index.mjs",
			"require": "./dist/opc/index.cjs"
		},
		"./collab": {
			"types": "./dist/collab/index.d.ts",
			"import": "./dist/collab/index.mjs",
			"require": "./dist/collab/index.cjs"
		},
		"./docx": {
			"types": "./dist/docx/index.d.ts",
			"import": "./dist/docx/index.mjs",
			"require": "./dist/docx/index.cjs"
		},
		"./docx/embedded": {
			"types": "./dist/docx/embedded.d.ts",
			"import": "./dist/docx/embedded.mjs",
			"require": "./dist/docx/embedded.cjs"
		},
		"./docx/layout": {
			"types": "./dist/docx/layout/index.d.ts",
			"import": "./dist/docx/layout/index.mjs",
			"require": "./dist/docx/layout/index.cjs"
		},
		"./docx/load": {
			"types": "./dist/docx/load/index.d.ts",
			"import": "./dist/docx/load/index.mjs",
			"require": "./dist/docx/load/index.cjs"
		},
		"./visio": {
			"types": "./dist/visio/index.d.ts",
			"import": "./dist/visio/index.mjs",
			"require": "./dist/visio/index.cjs"
		},
		"./xlsx": {
			"types": "./dist/xlsx/index.d.ts",
			"import": "./dist/xlsx/index.mjs",
			"require": "./dist/xlsx/index.cjs"
		},
		"./xlsx/load": {
			"types": "./dist/xlsx/load/index.d.ts",
			"import": "./dist/xlsx/load/index.mjs",
			"require": "./dist/xlsx/load/index.cjs"
		},
		"./pptx": {
			"types": "./dist/pptx/index.d.ts",
			"import": "./dist/pptx/index.mjs",
			"require": "./dist/pptx/index.cjs"
		},
		"./pptx/converter": {
			"types": "./dist/pptx/converter/index.d.ts",
			"import": "./dist/pptx/converter/index.mjs",
			"require": "./dist/pptx/converter/index.cjs"
		},
		"./pptx/cli": {
			"types": "./dist/pptx/cli/index.d.ts",
			"import": "./dist/pptx/cli/index.mjs",
			"require": "./dist/pptx/cli/index.cjs"
		},
		"./pptx/signature-node": {
			"types": "./dist/pptx/signature-node/index.d.ts",
			"import": "./dist/pptx/signature-node/index.mjs",
			"require": "./dist/pptx/signature-node/index.cjs"
		},
		"./math": {
			"types": "./dist/math/index.d.ts",
			"import": "./dist/math/index.mjs",
			"require": "./dist/math/index.cjs"
		},
		"./automation": {
			"types": "./dist/automation/index.d.ts",
			"import": "./dist/automation/index.mjs",
			"require": "./dist/automation/index.cjs"
		},
		"./automation/node": {
			"types": "./dist/automation/node.d.ts",
			"import": "./dist/automation/node.mjs",
			"require": "./dist/automation/node.cjs"
		},
		"./pptx/automation": {
			"types": "./dist/pptx/automation/index.d.ts",
			"import": "./dist/pptx/automation/index.mjs",
			"require": "./dist/pptx/automation/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:visio": "tsup --config tsup.visio.config.ts",
		"prepack": "node scripts/ensure-built.mjs",
		"typecheck": "bun run typecheck:strict && bun run typecheck:pptx",
		"typecheck:strict": "tsc -p tsconfig.json --noEmit",
		"typecheck:pptx": "tsc -p tsconfig.pptx.json --noEmit",
		"test": "vitest run",
		"gen:docx-schema-types": "bun scripts/gen-schema-types.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:package": "node scripts/package-smoke.mjs",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"check:changelog": "node scripts/check-changelog-sections.mjs",
		"release:plan": "node scripts/release-plan.mjs",
		"release:publish": "node scripts/publish-released.mjs",
		"changelog:unreleased": "bunx git-cliff --config cliff.toml --tag-pattern \"^ooxml-core@\" --unreleased",
		"test:mcp": "node --test mcp/test/*.test.js"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12",
		"emf-converter": "^3.3.0",
		"fast-xml-parser": "^5.11.1",
		"jszip": "^3.10.2",
		"lib0": "^0.2.117",
		"mtx-decompressor": "^1.6.0",
		"utif": "3.1.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.32"
	},
	"devDependencies": {
		"@christophervr/ole2": "0.8.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@napi-rs/canvas": "^1.0.9",
		"@types/node": "^22.0.0",
		"@types/node-forge": "^1.3.14",
		"@types/utif": "3.0.6",
		"node-forge": "^1.4.0",
		"oxfmt": "*",
		"tsdown": "^0.23.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.0",
		"xml-crypto": "^6.1.2",
		"xmllint-wasm": "5.3.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"node-forge": "^1.3.0",
		"xml-crypto": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"@napi-rs/canvas": {
			"optional": true
		},
		"node-forge": {
			"optional": true
		},
		"xml-crypto": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	}
}
