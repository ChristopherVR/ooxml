{
	"name": "ooxml",
	"private": true,
	"description": "The ooxml-core library, the shared ooxml-ui elements, the MCP servers and the Word, Excel, Visio and OpenTeams viewers, in one workspace",
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git"
	},
	"workspaces": [
		"src/core",
		"src/ui",
		"mcp",
		"viewers/*",
		"viewers/*/packages/*",
		"viewers/*/mcp",
		"viewers/*/docs",
		"viewers/teams/server",
		"demos/docx",
		"demos/xlsx",
		"demos/visio",
		"demos/teams",
		"apps/office-suite",
		"e2e/docx",
		"e2e/xlsx",
		"e2e/visio",
		"e2e/teams",
		"demos/teams/*",
		"demos/onedrive",
		"demos/pptx",
		"demos/pptx/demo-*",
		"e2e/pptx",
		"e2e/a11y"
	],
	"type": "module",
	"scripts": {
		"build": "bun run --cwd src/core build",
		"build:suite": "bun run build && bun run --cwd src/ui build && node scripts/build-suite.mjs",
		"preview:suite": "node scripts/preview-site.mjs",
		"preview:suite:onedrive": "bun scripts/preview-suite-onedrive.mjs",
		"test:suite": "node scripts/suite-browser-check.mjs",
		"test:suite:onedrive": "bun scripts/suite-onedrive-check.mjs",
		"test:onedrive:speed": "node scripts/onedrive-speed-check.mjs --mock",
		"test:demos": "node scripts/demo-browser-check.mjs",
		"test:suite:profile": "node scripts/suite-profile-check.mjs",
		"build:visio": "bun run --cwd src/core build:visio",
		"typecheck": "bun run --cwd src/core typecheck",
		"typecheck:strict": "bun run --cwd src/core typecheck:strict",
		"typecheck:pptx": "bun run --cwd src/core typecheck:pptx",
		"test": "bun run --cwd src/core test",
		"test:package": "bun run --cwd src/core test:package",
		"gen:docx-schema-types": "bun run --cwd src/core gen:docx-schema-types",
		"validate:schemas": "bun scripts/validate-schemas.mjs",
		"fmt": "oxfmt '!viewers/**'",
		"fmt:check": "oxfmt --check '!viewers/**'",
		"docs:check": "node scripts/check-docs.mjs --out docs-health.md",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"verify": "node scripts/verify.mjs",
		"check:changelog": "node scripts/check-changelog-sections.mjs",
		"check:elements": "bun run --cwd src/ui check:elements",
		"release:plan": "node scripts/release-plan.mjs",
		"release:publish": "node scripts/publish-released.mjs",
		"changelog:unreleased": "git-cliff --config cliff.toml --tag-pattern \"^ooxml-core@\" --unreleased",
		"test:mcp": "node --test mcp/test/*.test.js",
		"lint": "oxlint --ignore-pattern=viewers/",
		"lint:fix": "oxlint --fix --ignore-pattern=viewers/",
		"test:suite:regressions": "node scripts/suite-regression-check.mjs",
		"test:suite:simple-view": "node scripts/suite-simple-view-check.mjs",
		"test:suite:pptx-chart": "node scripts/suite-pptx-chart-check.mjs",
		"test:suite:files": "node scripts/suite-files-check.mjs",
		"test:suite:requests": "node scripts/suite-requests-check.mjs",
		"test:suite:review": "node scripts/suite-review-check.mjs",
		"test:suite:visio-presentation": "node scripts/suite-visio-presentation-check.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"git-cliff": "2.14.2",
		"jszip": "^3.10.2",
		"lightningcss": "^1.33.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"parse5": "^8.1.1",
		"pkg-pr-new": "0.0.94",
		"typescript": "6.0.3",
		"yaml": "2.9.1"
	},
	"overrides": {
		"argparse": "^2.0.1",
		"esbuild": "^0.28.2",
		"glob": "^14.0.2",
		"minimatch": "^11.0.1"
	},
	"engines": {
		"node": ">=22.3"
	}
}
