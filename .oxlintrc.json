{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "import", "promise", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"vitest/require-mock-type-parameters": "off",
		"vitest/valid-expect": "off",
		"import/namespace": "off",
		"import/no-unassigned-import": "off",
		"vitest/no-conditional-expect": "off",
		"vitest/no-conditional-tests": "off",
		"vitest/expect-expect": "off",
		"vitest/require-to-throw-message": "off",
		"vitest/valid-title": "off",
		"no-underscore-dangle": "off",
		"no-shadow": "off",
		"no-control-regex": "off",
		"no-useless-escape": "off",
		"promise/always-return": "off",
		"typescript/no-extraneous-class": "off",
		"typescript/no-unsafe-declaration-merging": "off",
		"typescript/no-this-alias": "off",
		"promise/no-callback-in-promise": "off"
	},
	"ignorePatterns": [
		"dist/",
		".release-types/",
		"node_modules/",
		"**/dist/**",
		"site/",
		"**/__fixtures__/**",
		".playwright-mcp/"
	],
	"overrides": [
		{
			// Every sound a PowerPoint viewer plays from a deck goes through `playDeckSound`
			// (render/deck-sound.ts), which withholds a linked sound until the viewer allows
			// linked content. Anything else that builds an `Audio` or an audio element skips
			// that consent: the global, `Audio` read off any object, `createElement('audio')`.
			"files": ["src/ui/src/pptx/**"],
			"jsPlugins": ["./scripts/lint/deck-sound-plugin.mjs"],
			"rules": {
				"deck-sound/no-unsanctioned-audio": "error",
				"no-restricted-globals": [
					"error",
					{
						"name": "Audio",
						"message": "Play deck sounds with playDeckSound (render/deck-sound.ts): it applies the viewer's linked-content consent."
					}
				]
			}
		},
		{
			// The sound sink itself, cross-slide audio (it plays a media element's source,
			// which the drawing gate already withholds before consent) and tests.
			"files": [
				"src/ui/src/pptx/render/deck-sound.ts",
				"src/ui/src/pptx/render/media-persistent-audio.ts",
				"src/ui/src/pptx/**/*.test.ts"
			],
			"rules": { "no-restricted-globals": "off", "deck-sound/no-unsanctioned-audio": "off" }
		}
	]
}
