{
	// Release-written changelogs and captured test artefacts are not hand-formatted.
	"ignorePatterns": [
		"**/CHANGELOG.md",
		"**/__fixtures__/**",
		"**/__snapshots__/**",
		// Written by src/core/pptx/automation/__tests__/tool-schemas.test.ts as a file snapshot.
		"src/core/pptx/automation/__tests__/tool-schemas.pptx.json",
		"**/excel-*.json",
		"**/evidence.json",
		// Bundled from src/core/teams by viewers/teams/scripts/bundle-validator.mjs; a test compares it.
		"viewers/teams/server/validator.generated.mjs",
		// Generated by src/core/scripts/xlsx/function-list.ts; a test compares it with the registry.
		"viewers/xlsx/docs/functions.md",
		// Generated from Tailwind's preflight; a test compares it with the generator output.
		"src/ui/src/pptx/theme/viewer-preflight.css"
	],
	"singleQuote": true,
	"useTabs": true,
	"printWidth": 100,
	"overrides": [
		{
			"files": ["src/ui/src/*.ts", "src/ui/src/**/*.ts"],
			"excludeFiles": ["src/ui/src/teams/**"],
			"options": {
				"htmlWhitespaceSensitivity": "strict"
			}
		},
		{
			"files": ["demos/pptx/**", "e2e/pptx/**"],
			"options": {
				"tabWidth": 2,
				"semi": true,
				"trailingComma": "all",
				"bracketSpacing": true,
				"arrowParens": "always",
				"endOfLine": "lf",
				"insertFinalNewline": true,
				"bracketSameLine": false,
				"jsxSingleQuote": true,
				"quoteProps": "as-needed",
				"proseWrap": "preserve",
				"htmlWhitespaceSensitivity": "css",
				"embeddedLanguageFormatting": "auto",
				"sortImports": {
					"groups": [
						"builtin",
						"external",
						["internal", "subpath"],
						["parent", "sibling", "index"],
						"style",
						"unknown"
					]
				},
				"sortPackageJson": true
			}
		}
	]
}
