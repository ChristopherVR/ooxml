{
	"name": "pptx-viewer-shared",
	"version": "0.1.0",
	"private": true,
	"description": "Private compatibility exports for the public ooxml-ui PowerPoint APIs. Implementation lives in src/ui/src/pptx.",
	"keywords": [
		"openxml",
		"powerpoint",
		"pptx",
		"presentation",
		"shared",
		"viewer"
	],
	"homepage": "https://christophervr.github.io/ooxml/pptx/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/pptx/packages/shared"
	},
	"files": [
		"dist/",
		"LICENSE",
		"NOTICE",
		"README.md"
	],
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"import": "./dist/theme/index.mjs",
			"require": "./dist/theme/index.js"
		},
		"./loader": {
			"types": "./dist/loader/index.d.ts",
			"import": "./dist/loader/index.mjs",
			"require": "./dist/loader/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"import": "./dist/i18n/index.mjs",
			"require": "./dist/i18n/index.js"
		},
		"./ai": {
			"types": "./dist/ai/index.d.ts",
			"import": "./dist/ai/index.mjs",
			"require": "./dist/ai/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "bun run --cwd ../../../../src/ui test:pptx",
		"test:watch": "bun run --cwd ../../../../src/ui test:pptx --watch",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"ooxml-ui": "^1.3.0"
	},
	"devDependencies": {
		"tsdown": "^0.23.0",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	}
}
