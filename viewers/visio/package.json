{
	"name": "@christophervr/visio-viewer",
	"version": "0.0.0",
	"private": true,
	"description": "Framework-neutral, local-first Visio viewer built on ooxml-core",
	"license": "Apache-2.0",
	"files": [
		"dist",
		"NOTICE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && vite build && node scripts/build-demos.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:browser": "playwright test && node scripts/test-packages-browser.mjs",
		"check": "npm run fmt:check && npm run check:core && npm run check:converter && npm run typecheck && npm test && npm run check:bindings && npm run test:docs && npm run build && npm run test:worker && npm run test:package && npm run test:scripts && npm run build:packages && npm run test:packages",
		"check:converter": "npm run test:converter-integration",
		"check:bindings": "npm --prefix packages/bindings run check",
		"test:docs": "node --test docs/site.test.mjs docs/theme.test.mjs",
		"test:worker": "node scripts/test-worker-bundle.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:package": "node scripts/test-package.mjs",
		"docs:dev": "npm --prefix docs run docs:dev",
		"docs:build": "node scripts/build-pages.mjs",
		"check:core": "node scripts/check-core.mjs",
		"test:corpus": "node scripts/test-corpus.mjs",
		"test:emf-audit": "node --test scripts/emf-audit/audit.test.mjs",
		"test:converter-integration": "node scripts/test-converter-integration.mjs",
		"link:core": "node scripts/link-core.mjs",
		"build:packages": "node scripts/build-packages.mjs",
		"test:packages": "node scripts/test-packages.mjs",
		"test:scripts": "node --test scripts/release-plan.test.mjs scripts/release-packages.test.mjs scripts/check-conventional-commits.test.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"emf-converter": "4.8.9",
		"ooxml-core": "0.20.0",
		"ooxml-ui": "0.28.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^22.20.5",
		"jsdom": "^30.1.2",
		"jszip": "^3.10.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"postcss": "^8.5.28",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22.12"
	}
}
