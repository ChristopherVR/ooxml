{
	"name": "@christophervr/visio-viewer",
	"version": "0.0.0",
	"private": true,
	"description": "Framework-neutral, local-first Visio viewer built on ooxml-core",
	"license": "UNLICENSED",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc -p tsconfig.build.json && vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:browser": "playwright test",
		"check": "npm run fmt:check && npm run test:converter-setup && npm run check:core && npm run typecheck && npm test && npm run check:bindings && npm run test:docs && npm run build && npm run test:worker && npm run test:package",
		"setup:core": "node scripts/setup-core.mjs",
		"setup:converter": "node scripts/setup-converter.mjs",
		"check:converter": "npm --prefix ../emf-converter-current run typecheck && npm --prefix ../emf-converter-current test && npm --prefix ../emf-converter-current run build && npm --prefix ../emf-converter-current run test:browser-package",
		"check:bindings": "npm --prefix packages/bindings run check",
		"test:docs": "node scripts/sync-parity.mjs --check && node --test docs/site.test.mjs",
		"test:worker": "node scripts/test-worker-bundle.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:package": "node scripts/test-package.mjs",
		"docs:sync": "node scripts/sync-parity.mjs",
		"check:core": "node scripts/check-core.mjs",
		"test:corpus": "node scripts/test-corpus.mjs",
		"test:emf-audit": "node --test scripts/emf-audit/audit.test.mjs",
		"test:converter-setup": "node --test scripts/test-converter-setup.mjs",
		"test:converter-integration": "node scripts/test-converter-integration.mjs"
	},
	"dependencies": {
		"ooxml-core": "file:../ooxml"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@types/node": "^24.0.0",
		"jsdom": "^29.0.0",
		"jszip": "^3.10.2",
		"oxfmt": "^0.71.0",
		"postcss": "^8.5.28",
		"typescript": "^5.9.3",
		"vite": "^8.0.0",
		"vitest": "^4.0.0"
	},
	"engines": {
		"node": ">=22.12"
	}
}
