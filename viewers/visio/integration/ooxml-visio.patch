+				`<Relationship Id="theme2" Type="${themeRelationship}" Target="theme/theme2.xml"/></Relationships>`,
+			),
+		);
+		zip.file('visio/theme/theme2.xml', generatedTheme());
+		const document = await parseVsdx(await zip.generateAsync({ type: 'uint8array' }));
