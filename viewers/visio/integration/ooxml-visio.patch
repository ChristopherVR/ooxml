+
+const cells = (value: string): Cells => new Map([['LinePattern', { value }]]);
+const expected: [number, number[]][] = [
+	[2, [6, 3]],
+	[3, [1, 3]],
+	[4, [6, 3, 1, 3]],
+	[5, [6, 3, 1, 3, 1, 3]],
+	[6, [6, 3, 6, 3, 1, 3]],
+	[7, [14, 2, 6, 2]],
+	[8, [14, 2, 6, 2, 6, 2]],
+	[9, [3, 2]],
+	[10, [1, 2]],
+	[11, [3, 2, 1, 2]],
+	[12, [3, 2, 1, 2, 1, 2]],
+	[13, [3, 2, 3, 2, 1, 2]],
+	[14, [7, 2, 3, 2]],
+	[15, [7, 2, 3, 2, 3, 2]],
+	[16, [11, 5]],
+	[17, [1, 5]],
+	[18, [11, 5, 1, 5]],
+	[19, [11, 5, 1, 5, 1, 5]],
+	[20, [11, 5, 11, 5, 1, 5]],
