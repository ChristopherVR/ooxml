{
	"name": "openteams-angular-viewer",
	"version": "0.1.0",
	"description": "Angular standalone component and service for OpenTeams, the open-source bring-your-own-server team workspace. Self-contained: includes the <teams-app> UI.",
	"keywords": [
		"angular",
		"chat",
		"collaboration",
		"openteams",
		"team-workspace",
		"webrtc",
		"yjs"
	],
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/teams-viewer.git",
		"directory": "packages/angular"
	},
	"homepage": "https://github.com/ChristopherVR/teams-viewer/tree/main/packages/angular#readme",
	"bugs": {
		"url": "https://github.com/ChristopherVR/teams-viewer/issues"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
