{
	"name": "teams-viewer-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Open-source, bring-your-own-server team workspace (chat, calls, shared Office files) built on ooxml-core",
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": [
		"packages/*",
		"server",
		"demos/*"
	],
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"server": "node server/index.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && npm run test:server",
		"test:server": "node --test server/server.test.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"jsdom": "^30.1.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"ooxml-core": "*",
		"ooxml-ui": "*",
		"yjs": "^13.6.33",
		"lit": "^3.3.3",
		"lib0": "^0.2.119",
		"y-protocols": "^1.0.7"
	},
	"overrides": {
		"ooxml-core": "*"
	}
}
