{
	"name": "docx-vue-viewer",
	"version": "0.4.2",
	"description": "Vue 3 component for the DOCX editor. Self-contained: includes the editor, layout engine and legacy .doc reader.",
	"keywords": [
		"doc",
		"docx",
		"editor",
		"vue",
		"word"
	],
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/docx-viewer.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"docx-core": "^0.1.5",
		"ooxml-core": "^0.20.0",
		"ooxml-ui": "^0.28.0"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	}
}
