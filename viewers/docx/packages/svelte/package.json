{
	"name": "docx-svelte-viewer",
	"version": "0.4.2",
	"description": "Svelte 5 component for the DOCX editor. Self-contained: includes the editor, layout engine and legacy .doc reader.",
	"keywords": [
		"doc",
		"docx",
		"editor",
		"svelte",
		"word"
	],
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/docx-viewer.git",
		"directory": "packages/svelte"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/runtime.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/WordEditor.svelte",
			"default": "./dist/WordEditor.svelte"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"docx-core": "^0.1.5",
		"ooxml-core": "^0.17.0",
		"ooxml-ui": "^0.27.0",
		"prosemirror-collab": "^1.3.1",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.2",
		"prosemirror-view": "^1.42.6"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
