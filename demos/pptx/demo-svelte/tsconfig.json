{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "vite/client", "svelte"],
		"paths": {
			"pptx-svelte-viewer/viewer": ["../../../viewers/pptx/packages/svelte/src/viewer/index.ts"],
			"pptx-svelte-viewer/i18n": ["../../../viewers/pptx/packages/svelte/src/i18n.ts"],
			"pptx-svelte-viewer": ["../../../viewers/pptx/packages/svelte/src/index.ts"],
			"pptx-viewer-core/converter": ["../../../viewers/pptx/packages/core/src/converter/index.ts"],
			"pptx-viewer-core": ["../../../viewers/pptx/packages/core/src/index.ts"],
			"pptx-viewer-shared": ["../../../src/ui/src/pptx/index.ts"]
		}
	},
	"include": ["src"]
}
