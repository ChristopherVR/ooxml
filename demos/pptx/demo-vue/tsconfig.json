{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"jsxImportSource": "vue",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "vite/client"],
		"paths": {
			"pptx-vue-viewer/viewer": ["../../../viewers/pptx/packages/vue/src/viewer/index.ts"],
			"pptx-vue-viewer": ["../../../viewers/pptx/packages/vue/src/index.ts"],
			"pptx-viewer-core/converter": ["../../../viewers/pptx/packages/core/src/converter/index.ts"],
			"pptx-viewer-core": ["../../../viewers/pptx/packages/core/src/index.ts"],
			"pptx-viewer-shared": ["../../../viewers/pptx/packages/shared/src/index.ts"]
		}
	},
	"include": ["src", "src/**/*.vue", "vite.config.ts"]
}
