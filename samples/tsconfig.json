{
	// The generators import ooxml-core from source, so a change to a core model or writer that
	// breaks one fails here (scripts/samples.test.mjs runs it) rather than at the next rebuild.
	"extends": "../src/core/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"types": ["node"],
		"typeRoots": ["../src/core/node_modules/@types"]
	},
	"include": ["generators/**/*.ts"],
	"exclude": []
}
